      SuperscriptBox["Q", "2"], " ", 
      SuperscriptBox["gO", "2"], " ", 
      SuperscriptBox["gM", "2"], " ", 
      SuperscriptBox["omegaB", "2"]}]}]]}],
  HoldForm]], "Output",
