       SqrtBox[
        FractionBox["FBlue", "\[Pi]"]], " ", "\[CapitalOmega]b"}]}], ",", 
     RowBox[{"Ein", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Epsilon]", "\[Rule]", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parmsScreenshot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"G", "\[Rule]", "15.847456497032729`"}], ",", 
     RowBox[{"G\[Mu]", "\[Rule]", "2.0917014542834487`"}], ",", 
     RowBox[{"\[Kappa]", "\[Rule]", "10.`"}], ",", 
     RowBox[{"\[CapitalGamma]", "\[Rule]", "6.`"}], ",", 
     RowBox[{"\[CapitalDelta]e", "\[Rule]", "0"}], ",", 
     RowBox[{"\[CapitalDelta]r", "\[Rule]", "0"}], ",", 
     RowBox[{"\[Gamma]r", "\[Rule]", "0.1`"}], ",", 
     RowBox[{"\[Kappa]\[Mu]", "\[Rule]", "5.`"}], ",", 
     RowBox[{"\[CapitalDelta]\[Mu]", "\[Rule]", "0"}], ",", 
     RowBox[{"\[CapitalOmega]", "\[Rule]", "5.524973392693388`"}], ",", 
     RowBox[{"Ein", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Epsilon]", "\[Rule]", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parameterSet", "=", "\"\<Screenshot\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parms", "=", 
   RowBox[{"Switch", "[", 
    RowBox[{
    "parameterSet", ",", "\"\<Original notebook\>\"", ",", "parmsOriginal", 
     ",", "\"\<Screenshot\>\"", ",", "parmsScreenshot"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"portRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"etaOpt", "\[Rule]", "1.`"}], ",", 
     RowBox[{"etaMM", "\[Rule]", "1.`"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"2d65a4c0-7b4b-ce49-9893-6ee490ae0e09"],

Cell["\<\
The lattice calculation assumes two independent perpendicular \
second-order-QPM axes with equal depths. The user-specified calibration is \
U/kB = 5 microkelvin per watt per axis per beam; the waist is 200 \
micrometres. Temperature zero here is the harmonic lowest-band limit, which \
still includes zero-point spatial motion.\
\>", "Text",ExpressionUUID->"cee34084-2a18-7046-b645-06cd59afdbfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"planckH", "=", 
   FractionBox["6.62607015`", 
    SuperscriptBox["10", "34"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"boltzmannK", "=", 
   FractionBox["1.380649`", 
    SuperscriptBox["10", "23"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rb85Mass", "=", 
   FractionBox[
    RowBox[{"84.9117897379`", " ", "1.6605390666`"}], 
    SuperscriptBox["10", "27"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"latticeWavelength", "=", 
   FractionBox["1188", 
    SuperscriptBox["10", "9"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recoilUK", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["planckH", "2"], " ", 
     SuperscriptBox["10", "6"]}], 
    RowBox[{"2", " ", "rb85Mass", " ", 
     SuperscriptBox["latticeWavelength", "2"], " ", "boltzmannK"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"latticeWaistUM", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"latticePowerPerBeam", "=", "3.`"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"latticeDepthUK", "=", 
   RowBox[{"5", " ", "latticePowerPerBeam"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temperatureUK", "=", "0.`"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b2", "[", 
    RowBox[{
     RowBox[{"depth_", "?", "NumericQ"}], ",", 
     RowBox[{"temp_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "4"}], " ", 
     SqrtBox[
      FractionBox["recoilUK", "depth"]], " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"temp", "\[Equal]", "0"}], ",", "1", ",", 
       RowBox[{"Coth", "[", 
        FractionBox[
         SqrtBox[
          RowBox[{"depth", " ", "recoilUK"}]], "temp"], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2x", "=", 
   RowBox[{"b2", "[", 
    RowBox[{"latticeDepthUK", ",", "temperatureUK"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2z", "=", 
   RowBox[{"b2", "[", 
    RowBox[{"latticeDepthUK", ",", "temperatureUK"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qValue", "=", 
   RowBox[{"b2x", " ", "b2z"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qRule", "=", 
   RowBox[{"{", 
    RowBox[{"Q", "\[Rule]", "qValue"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<b2 per axis\>\"", "\[Rule]", "b2x"}], ",", 
   RowBox[{"\"\<Q = b2x b2z\>\"", "\[Rule]", "qValue"}], ",", 
   RowBox[{"\"\<Q squared\>\"", "\[Rule]", 
    SuperscriptBox["qValue", "2"]}]}], "]"}]}], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"0a5b8b90-0e7c-0a45-ba25-159739139764"],

