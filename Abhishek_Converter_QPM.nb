  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0010172995445957`*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"3a407e33-d912-8947-a840-6242e6286de1"]
}, Open  ]],

Cell["\<\
EfficiencyProjected implements only Gmu -> Q Gmu. EfficiencyQ also retains \
the orthogonal atomic response. These are two different models; multiplying \
the original efficiency by Q^2 is not equivalent to either one.\
\>", "Text",ExpressionUUID->"b479218a-8cf0-2448-ada3-ec5b60dfd55d"]
}, Open  ]],

