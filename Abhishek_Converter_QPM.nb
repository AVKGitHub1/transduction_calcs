}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"solutionQ", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"equationsQ", ",", "variablesQ"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConverterEfficQFromSolve", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{"\[Kappa]\[Mu]", " ", "\[Kappa]"}]], " ", 
    RowBox[{"(", 
     RowBox[{"b", "/.", "\[VeryThinSpace]", "solutionQ"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"b5ee1d8d-0249-c24b-849f-2b066ca44393"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compact analytical amplitude and orthogonal-mode response", "Section",ExpressionUUID->"64d1a302-4032-fe42-aa6a-afd6482cb5de"],

Cell["\<\
The following factored expression equals the direct Solve result. The \
definitions include epsilon so that the full symbolic convention of the \
original notebook is preserved. Eliminating the orthogonal pair adds \
SigmaPerp to dm; it does not change the useful microwave output-port coupling.\
\>", "Text",ExpressionUUID->"006212e0-b5ef-2f4f-ad7f-f8949eee7ff1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"da", "=", 
   RowBox[{
    FractionBox["\[Kappa]", "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", "\[Omega]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"de", "=", 
   RowBox[{
    FractionBox["\[CapitalGamma]", "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "\[CapitalDelta]e"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dr", "=", 
   RowBox[{
    FractionBox["\[Gamma]r", "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "\[CapitalDelta]r"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dm", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Gamma]r", "+", "\[Kappa]\[Mu]"}], "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "\[CapitalDelta]\[Mu]"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"go", "=", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "G"}], 
    SqrtBox["2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gm", "=", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "G\[Mu]"}], 
    SqrtBox["2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ob", "=", 
   RowBox[{"\[Epsilon]", " ", "\[CapitalOmega]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"atomicDen", "=", 
   RowBox[{
    RowBox[{"de", " ", "dr"}], "+", 
    SuperscriptBox["ob", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opticalFactor", "=", 
   RowBox[{
    RowBox[{"da", " ", "atomicDen"}], "+", 
    RowBox[{
     SuperscriptBox["go", "2"], " ", "dr"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"microwaveFactor", "=", 
   RowBox[{
    RowBox[{"dm", " ", "atomicDen"}], "+", 
    RowBox[{
     SuperscriptBox["gm", "2"], " ", "de"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denominatorQ", "=", 
   RowBox[{
    RowBox[{"opticalFactor", " ", "microwaveFactor"}], "+", 
    RowBox[{
     SuperscriptBox["Q", "2"], " ", 
     SuperscriptBox["go", "2"], " ", 
     SuperscriptBox["gm", "2"], " ", 
     SuperscriptBox["ob", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConverterEfficQ", "=", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "Ein", " ", 
     SqrtBox[
      RowBox[{"\[Kappa]\[Mu]", " ", "\[Kappa]"}]], " ", "go", " ", "gm", " ", 
     "ob", " ", "Q", " ", "atomicDen"}], "denominatorQ"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SigmaPerp", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["gm", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["Q", "2"]}], ")"}], " ", "de"}], "atomicDen"]}], 
  ";"}], "\[IndentingNewLine]", "SigmaPerp"}], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"066428a7-1874-084f-8f3e-584736d99887"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["G\[Mu]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["Q", "2"]}], ")"}], " ", 
   SuperscriptBox["\[Epsilon]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["\[CapitalGamma]", "2"], "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[CapitalDelta]e"}], "+", "\[Omega]"}], ")"}]}]}], 
    ")"}]}], 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["\[CapitalGamma]", "2"], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "\[CapitalDelta]e"}], "+", "\[Omega]"}], ")"}]}]}], 
       ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["\[Gamma]r", "2"], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "\[CapitalDelta]r"}], "+", "\[Omega]"}], ")"}]}]}], 
       ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[Epsilon]", "2"], " ", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]}], ")"}]}]]], "Output",
 CellChangeTimes->{4.001017299072813*^9, 4.001099140120577*^9, 
  4.001099227277418*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"096e6b3b-b7be-8549-af0d-52734ee90dd4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solveAgreement", "=", 
   RowBox[{"TrueQ", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{"ConverterEfficQFromSolve", "-", "ConverterEfficQ"}], "]"}], "\[Equal]",
        "0"}], ",", "assumptions"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"orthogonalSolution", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"equationsQ", "\[LeftDoubleBracket]", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6"}], "}"}], "\[RightDoubleBracket]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rPerp", ",", "pPerp"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmaAgreement", "=", 
   RowBox[{"TrueQ", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"\[ImaginaryI]", " ", "gm", " ", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["Q", "2"]}]], " ", "rPerp"}], "b"]}], "/.", 
           "\[VeryThinSpace]", "orthogonalSolution"}], ")"}], "-", 
         "SigmaPerp"}], "]"}], "\[Equal]", "0"}], ",", "assumptions"}], "]"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<Solve equals compact amplitude\>\"", "\[Rule]", 
    "solveAgreement"}], ",", 
   RowBox[{"\"\<Elimination gives SigmaPerp\>\"", "\[Rule]", 
    "sigmaAgreement"}]}], "]"}]}], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"7d24e11c-cd1b-6845-b24f-3a7ced971b60"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Solve equals compact amplitude\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Elimination gives SigmaPerp\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0010172991154785`*^9, 4.0010991401637726`*^9, 
  4.0010992273192825`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"4f531f23-98af-5240-a270-a6e54ede9d0a"]
}, Open  ]],

Cell["\<\
This display uses inert labels for the compact formula; the evaluated \
expression is stored in ConverterEfficQ. The labels fAtom, yOpt and zMM \
denote atomicDen, opticalFactor and microwaveFactor; gO, gM and omegaB denote \
go, gm and ob.\
\>", "Text",ExpressionUUID->"108e2bf9-950f-af44-881b-c8d6d1d563a0"],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  RowBox[{"ConverterEfficQ", "\[Equal]", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "Ein", " ", 
     SqrtBox[
      RowBox[{"\[Kappa]", " ", "\[Kappa]\[Mu]"}]], " ", "gO", " ", "gM", " ", 
     "omegaB", " ", "Q", " ", "fAtom"}], 
    RowBox[{
     RowBox[{"yOpt", " ", "zMM"}], "+", 
     RowBox[{
      SuperscriptBox["Q", "2"], " ", 
      SuperscriptBox["gO", "2"], " ", 
      SuperscriptBox["gM", "2"], " ", 
      SuperscriptBox["omegaB", "2"]}]}]]}],
  HoldForm]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"282cf7f3-05e6-2b43-830d-1411cb7ca89f"],

Cell[BoxData[
