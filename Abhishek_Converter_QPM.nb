    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]UV", "]"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nopt", "=", 
   RowBox[{"Natoms", " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", "\[Theta]UV", "]"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
