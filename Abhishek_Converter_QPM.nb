Notebook[{

Cell[CellGroupData[{
Cell["Converter efficiency with quasi-phase matching", "Title",ExpressionUUID->"ca8c981f-d35e-c849-aaa8-2ed9dcbcf5f1"],

Cell["\<\
Six collective modes; symbolic Q; conventions of Abhishek_Converter.nb\
\>", "Subtitle",ExpressionUUID->"991bec0a-c961-7647-ba57-8f6809412653"],

Cell["\<\
Evaluate the notebook from the top. Q is the real magnitude of the normalized \
overlap of the optical/blue and UV/microwave collective atomic profiles. It \
remains symbolic until the numerical example at the end. The extra modes \
pPerp and rPerp retain the orthogonal collective response. This is the \
uniform-control, homogeneous-linewidth, frozen-position linear model \
discussed in the accompanying calculation.\
\>", "Text",ExpressionUUID->"272b351c-351f-9b49-a2b5-99f29336f3d5"],

Cell["\<\
The equations preserve the supplied notebook's signs, epsilon, drive Ein, \
G/Sqrt[2], Gmu/Sqrt[2], and (gammar + kappamu)/2 microwave damping. Omega is \
the coupling matrix element used in the original file. Rates in the numerical \
examples use its MHz convention. CellContext is Notebook, so this notebook \
has its own symbol context.\
\>", "Text",ExpressionUUID->"4e857106-2dbe-b741-8004-3229b40c21d3"],

Cell[CellGroupData[{

Cell["Symbolic assumptions and six equations", "Section",ExpressionUUID->"f1326017-84ab-a543-b8d6-3aa0bba6321a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Evaluate", "[", 
    RowBox[{"$Context", "<>", "\"\<*\>\""}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assumptions", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "G", ",", "G\[Mu]", ",", "\[Kappa]", ",", "\[CapitalGamma]", ",", 
       "\[CapitalDelta]e", ",", "\[CapitalDelta]r", ",", "\[Gamma]r", ",", 
       "\[Kappa]\[Mu]", ",", "\[CapitalDelta]\[Mu]", ",", "\[CapitalOmega]", ",",
        "Ein", ",", "\[Epsilon]", ",", "\[Omega]", ",", "Q"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}], "&&", 
    RowBox[{"G", ">", "0"}], "&&", 
    RowBox[{"G\[Mu]", ">", "0"}], "&&", 
    RowBox[{"\[Kappa]", ">", "0"}], "&&", 
    RowBox[{"\[CapitalGamma]", ">", "0"}], "&&", 
    RowBox[{"\[Gamma]r", ">", "0"}], "&&", 
    RowBox[{"\[Kappa]\[Mu]", ">", "0"}], "&&", 
    RowBox[{"\[CapitalOmega]", ">", "0"}], "&&", 
    RowBox[{"Ein", ">", "0"}], "&&", 
    RowBox[{"\[Epsilon]", ">", "0"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "Q", "\[LessEqual]", "1"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"e695bb0b-d100-0349-a6a9-170547be3d5c"],

Cell["\<\
a and b are the optical and microwave cavity amplitudes. p and r are the \
optically addressed collective optical and Rydberg amplitudes. pPerp and \
rPerp are the orthogonal pair. The microwave coupling splits into Q \
Gmu/Sqrt[2] and Sqrt[1-Q^2] Gmu/Sqrt[2]. Detunings are real and may be zero \
or negative.\
\>", "Text",ExpressionUUID->"ce071188-763d-514d-b96a-58ac9b980b86"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"equationsQ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", "a"}],
       "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "G", " ", "p"}], 
        SqrtBox["2"]], "-", 
       FractionBox[
        RowBox[{"\[Kappa]", " ", "a"}], "2"], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", "Ein"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", "p"}],
       "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "G", " ", "a"}], 
        SqrtBox["2"]], "+", 
       RowBox[{
       "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]", " ", "r"}],
        "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[CapitalGamma]", "2"], "-", 
          RowBox[{
          "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalDelta]e"}]}], 
         ")"}], " ", "p"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", "r"}],
       "\[Equal]", 
      RowBox[{
       RowBox[{
       "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]", " ", "p"}],
        "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[Gamma]r", "2"], "-", 
          RowBox[{
          "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalDelta]r"}]}], 
         ")"}], " ", "r"}], "+", 
       FractionBox[
        RowBox[{
        "\[Epsilon]", " ", "\[ImaginaryI]", " ", "G\[Mu]", " ", "Q", " ", 
         "b"}], 
        SqrtBox["2"]]}]}], ",", 
     RowBox[{
      RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", "b"}],
       "\[Equal]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Gamma]r", "+", "\[Kappa]\[Mu]"}], "2"], "-", 
           RowBox[{
           "\[Epsilon]", " ", "\[ImaginaryI]", " ", 
            "\[CapitalDelta]\[Mu]"}]}], ")"}]}], " ", "b"}], "+", 
       FractionBox[
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "G\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Q", " ", "r"}], "+", 
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["Q", "2"]}]], " ", "rPerp"}]}], ")"}]}], 
        SqrtBox["2"]]}]}], ",", 
     RowBox[{
      RowBox[{
      "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", "rPerp"}], "\[Equal]", 
      RowBox[{
       RowBox[{
       "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]", " ", 
        "pPerp"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[Gamma]r", "2"], "-", 
          RowBox[{
          "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalDelta]r"}]}], 
         ")"}], " ", "rPerp"}], "+", 
       FractionBox[
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]", " ", "G\[Mu]", " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["Q", "2"]}]], " ", "b"}], 
        SqrtBox["2"]]}]}], ",", 
     RowBox[{
      RowBox[{
      "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", "pPerp"}], "\[Equal]", 
      RowBox[{
       RowBox[{
       "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]", " ", 
        "rPerp"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[CapitalGamma]", "2"], "-", 
          RowBox[{
          "\[Epsilon]", " ", "\[ImaginaryI]", " ", "\[CapitalDelta]e"}]}], 
         ")"}], " ", "pPerp"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"variablesQ", "=", 
   RowBox[{"{", 
    RowBox[{"a", ",", "p", ",", "r", ",", "b", ",", "rPerp", ",", "pPerp"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"equationsQ", ",", 
   RowBox[{"Spacings", "\[Rule]", "1"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"13b11a35-c05b-164e-81f5-0147ce6c239b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "a", " ", "\[Epsilon]", " ", "\[Omega]"}],
       "\[Equal]", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "Ein", " ", "\[Epsilon]"}], "+", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "G", " ", "p", " ", "\[Epsilon]"}], 
        SqrtBox["2"]], "-", 
       FractionBox[
        RowBox[{"a", " ", "\[Kappa]"}], "2"]}]}]},
    {
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "\[Epsilon]", " ", "\[Omega]"}],
       "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "a", " ", "G", " ", "\[Epsilon]"}], 
        SqrtBox["2"]], "-", 
       RowBox[{"p", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[CapitalGamma]", "2"], "-", 
          RowBox[{
          "\[ImaginaryI]", " ", "\[CapitalDelta]e", " ", "\[Epsilon]"}]}], 
         ")"}]}], "+", 
       RowBox[{
       "\[ImaginaryI]", " ", "r", " ", "\[Epsilon]", " ", 
        "\[CapitalOmega]"}]}]}]},
    {
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "r", " ", "\[Epsilon]", " ", "\[Omega]"}],
       "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{
        "\[ImaginaryI]", " ", "b", " ", "G\[Mu]", " ", "Q", " ", 
         "\[Epsilon]"}], 
        SqrtBox["2"]], "-", 
       RowBox[{"r", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[Gamma]r", "2"], "-", 
          RowBox[{
          "\[ImaginaryI]", " ", "\[CapitalDelta]r", " ", "\[Epsilon]"}]}], 
         ")"}]}], "+", 
       RowBox[{
       "\[ImaginaryI]", " ", "p", " ", "\[Epsilon]", " ", 
        "\[CapitalOmega]"}]}]}]},
    {
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "b", " ", "\[Epsilon]", " ", "\[Omega]"}],
       "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "G\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Q", " ", "r"}], "+", 
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["Q", "2"]}]], " ", "rPerp"}]}], ")"}], " ", 
         "\[Epsilon]"}], 
        SqrtBox["2"]], "+", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "\[ImaginaryI]", " ", "\[CapitalDelta]\[Mu]", " ", "\[Epsilon]"}], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "\[Gamma]r"}], "-", "\[Kappa]\[Mu]"}], ")"}]}]}], 
         ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{
      "\[ImaginaryI]", " ", "rPerp", " ", "\[Epsilon]", " ", "\[Omega]"}], "\[Equal]", 
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "b", " ", "G\[Mu]", " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["Q", "2"]}]], " ", "\[Epsilon]"}], 
        SqrtBox["2"]], "-", 
       RowBox[{"rPerp", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[Gamma]r", "2"], "-", 
          RowBox[{
          "\[ImaginaryI]", " ", "\[CapitalDelta]r", " ", "\[Epsilon]"}]}], 
         ")"}]}], "+", 
       RowBox[{
       "\[ImaginaryI]", " ", "pPerp", " ", "\[Epsilon]", " ", 
        "\[CapitalOmega]"}]}]}]},
    {
     RowBox[{
      RowBox[{
      "\[ImaginaryI]", " ", "pPerp", " ", "\[Epsilon]", " ", "\[Omega]"}], "\[Equal]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "pPerp"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[CapitalGamma]", "2"], "-", 
          RowBox[{
          "\[ImaginaryI]", " ", "\[CapitalDelta]e", " ", "\[Epsilon]"}]}], 
         ")"}]}], "+", 
       RowBox[{
       "\[ImaginaryI]", " ", "rPerp", " ", "\[Epsilon]", " ", 
        "\[CapitalOmega]"}]}]}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.0010172981972313`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"a3cf4962-8831-3149-8e96-783166ca2e25"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"solutionQ", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"equationsQ", ",", "variablesQ"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConverterEfficQFromSolve", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{"\[Kappa]\[Mu]", " ", "\[Kappa]"}]], " ", 
    RowBox[{"(", 
     RowBox[{"b", "/.", "\[VeryThinSpace]", "solutionQ"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"b5ee1d8d-0249-c24b-849f-2b066ca44393"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compact analytical amplitude and orthogonal-mode response", "Section",ExpressionUUID->"64d1a302-4032-fe42-aa6a-afd6482cb5de"],

Cell["\<\
The following factored expression equals the direct Solve result. The \
definitions include epsilon so that the full symbolic convention of the \
original notebook is preserved. Eliminating the orthogonal pair adds \
SigmaPerp to dm; it does not change the useful microwave output-port coupling.\
\>", "Text",ExpressionUUID->"006212e0-b5ef-2f4f-ad7f-f8949eee7ff1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"da", "=", 
   RowBox[{
    FractionBox["\[Kappa]", "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", "\[Omega]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"de", "=", 
   RowBox[{
    FractionBox["\[CapitalGamma]", "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "\[CapitalDelta]e"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dr", "=", 
   RowBox[{
    FractionBox["\[Gamma]r", "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "\[CapitalDelta]r"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dm", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Gamma]r", "+", "\[Kappa]\[Mu]"}], "2"], "+", 
    RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "\[CapitalDelta]\[Mu]"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"go", "=", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "G"}], 
    SqrtBox["2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gm", "=", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "G\[Mu]"}], 
    SqrtBox["2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ob", "=", 
   RowBox[{"\[Epsilon]", " ", "\[CapitalOmega]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"atomicDen", "=", 
   RowBox[{
    RowBox[{"de", " ", "dr"}], "+", 
    SuperscriptBox["ob", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opticalFactor", "=", 
   RowBox[{
    RowBox[{"da", " ", "atomicDen"}], "+", 
    RowBox[{
     SuperscriptBox["go", "2"], " ", "dr"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"microwaveFactor", "=", 
   RowBox[{
    RowBox[{"dm", " ", "atomicDen"}], "+", 
    RowBox[{
     SuperscriptBox["gm", "2"], " ", "de"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denominatorQ", "=", 
   RowBox[{
    RowBox[{"opticalFactor", " ", "microwaveFactor"}], "+", 
    RowBox[{
     SuperscriptBox["Q", "2"], " ", 
     SuperscriptBox["go", "2"], " ", 
     SuperscriptBox["gm", "2"], " ", 
     SuperscriptBox["ob", "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConverterEfficQ", "=", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "Ein", " ", 
     SqrtBox[
      RowBox[{"\[Kappa]\[Mu]", " ", "\[Kappa]"}]], " ", "go", " ", "gm", " ", 
     "ob", " ", "Q", " ", "atomicDen"}], "denominatorQ"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SigmaPerp", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["gm", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["Q", "2"]}], ")"}], " ", "de"}], "atomicDen"]}], 
  ";"}], "\[IndentingNewLine]", "SigmaPerp"}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"066428a7-1874-084f-8f3e-584736d99887"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["G\[Mu]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["Q", "2"]}], ")"}], " ", 
   SuperscriptBox["\[Epsilon]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["\[CapitalGamma]", "2"], "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[CapitalDelta]e"}], "+", "\[Omega]"}], ")"}]}]}], 
    ")"}]}], 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["\[CapitalGamma]", "2"], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "\[CapitalDelta]e"}], "+", "\[Omega]"}], ")"}]}]}], 
       ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["\[Gamma]r", "2"], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Epsilon]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "\[CapitalDelta]r"}], "+", "\[Omega]"}], ")"}]}]}], 
       ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[Epsilon]", "2"], " ", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]}], ")"}]}]]], "Output",
 CellChangeTimes->{4.001017299072813*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"f601bdca-4119-4544-9ee5-d70e389cad8c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solveAgreement", "=", 
   RowBox[{"TrueQ", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{"ConverterEfficQFromSolve", "-", "ConverterEfficQ"}], "]"}], "\[Equal]",
        "0"}], ",", "assumptions"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"orthogonalSolution", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"equationsQ", "\[LeftDoubleBracket]", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6"}], "}"}], "\[RightDoubleBracket]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rPerp", ",", "pPerp"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmaAgreement", "=", 
   RowBox[{"TrueQ", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"\[ImaginaryI]", " ", "gm", " ", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["Q", "2"]}]], " ", "rPerp"}], "b"]}], "/.", 
           "\[VeryThinSpace]", "orthogonalSolution"}], ")"}], "-", 
         "SigmaPerp"}], "]"}], "\[Equal]", "0"}], ",", "assumptions"}], "]"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<Solve equals compact amplitude\>\"", "\[Rule]", 
    "solveAgreement"}], ",", 
   RowBox[{"\"\<Elimination gives SigmaPerp\>\"", "\[Rule]", 
    "sigmaAgreement"}]}], "]"}]}], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"7d24e11c-cd1b-6845-b24f-3a7ced971b60"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Solve equals compact amplitude\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Elimination gives SigmaPerp\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0010172991154785`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"3cd68a75-6423-3947-ba3c-99ddcb08901a"]
}, Open  ]],

Cell["\<\
This display uses inert labels for the compact formula; the evaluated \
expression is stored in ConverterEfficQ. The labels fAtom, yOpt and zMM \
denote atomicDen, opticalFactor and microwaveFactor; gO, gM and omegaB denote \
go, gm and ob.\
\>", "Text",ExpressionUUID->"108e2bf9-950f-af44-881b-c8d6d1d563a0"],

Cell[CellGroupData[{

Cell[BoxData[
 TagBox[
  RowBox[{"ConverterEfficQ", "\[Equal]", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "Ein", " ", 
     SqrtBox[
      RowBox[{"\[Kappa]", " ", "\[Kappa]\[Mu]"}]], " ", "gO", " ", "gM", " ", 
     "omegaB", " ", "Q", " ", "fAtom"}], 
    RowBox[{
     RowBox[{"yOpt", " ", "zMM"}], "+", 
     RowBox[{
      SuperscriptBox["Q", "2"], " ", 
      SuperscriptBox["gO", "2"], " ", 
      SuperscriptBox["gM", "2"], " ", 
      SuperscriptBox["omegaB", "2"]}]}]]}],
  HoldForm]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"282cf7f3-05e6-2b43-830d-1411cb7ca89f"],

Cell[BoxData[
 TagBox[
  RowBox[{"ConverterEfficQ", "\[Equal]", 
   FractionBox[
    RowBox[{"\[Epsilon]", " ", "Ein", " ", 
     SqrtBox[
      RowBox[{"\[Kappa]", " ", "\[Kappa]\[Mu]"}]], " ", "gO", " ", "gM", " ", 
