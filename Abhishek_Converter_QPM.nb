Cell[CellGroupData[{

Cell["\<\
Efficiency, original-model limit, and projected approximation\
\>", "Section",ExpressionUUID->"2dc0f53f-4d6b-fb42-83ff-660109d658f1"],

Cell["\<\
EfficiencyQ follows the original definition Abs[ConverterEffic]^2. Because \
the source keeps Ein explicit, use EfficiencyQ/Ein^2 for an \
input-amplitude-normalized result. All numerical examples below set Ein = 1. \
No numerical value of Q has been assigned.\
\>", "Text",ExpressionUUID->"aec4d308-0bcd-bc47-a9ab-65444194bf10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EfficiencyQ", "=", 
   RowBox[{"Refine", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", "ConverterEfficQ", "]"}], "2"], ",", 
     "assumptions"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NormalizedEfficiencyQ", "=", 
   FractionBox["EfficiencyQ", 
    SuperscriptBox["Ein", "2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalEquations", "=", 
   RowBox[{
    RowBox[{"equationsQ", "\[LeftDoubleBracket]", 
     RowBox[{"1", ";;", "4"}], "\[RightDoubleBracket]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Q", "\[Rule]", "1"}], ",", 
      RowBox[{"rPerp", "\[Rule]", "0"}], ",", 
      RowBox[{"pPerp", "\[Rule]", "0"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalSolution", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"originalEquations", ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "p", ",", "r"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConverterEfficOriginal", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{"\[Kappa]\[Mu]", " ", "\[Kappa]"}]], " ", 
    RowBox[{"(", 
     RowBox[{"b", "/.", "\[VeryThinSpace]", "originalSolution"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EfficiencyOriginal", "=", 
   RowBox[{"Refine", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", "ConverterEfficOriginal", "]"}], "2"], ",", 
     "assumptions"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConverterEfficProjected", "=", 
   RowBox[{"ConverterEfficOriginal", "/.", "\[VeryThinSpace]", 
    RowBox[{"G\[Mu]", "\[Rule]", 
     RowBox[{"Q", " ", "G\[Mu]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EfficiencyProjected", "=", 
   RowBox[{"Refine", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", "ConverterEfficProjected", "]"}], "2"], ",", 
     "assumptions"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalLimitCheck", "=", 
   RowBox[{"TrueQ", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ConverterEfficQ", "/.", "\[VeryThinSpace]", 
           RowBox[{"Q", "\[Rule]", "1"}]}], ")"}], "-", 
         "ConverterEfficOriginal"}], "]"}], "\[Equal]", "0"}], ",", 
      "assumptions"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zeroOverlapCheck", "=", 
   RowBox[{"TrueQ", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ConverterEfficQ", "/.", "\[VeryThinSpace]", 
        RowBox[{"Q", "\[Rule]", "0"}]}], ",", "assumptions"}], "]"}], "\[Equal]",
      "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<Q = 1 recovers uploaded model\>\"", "\[Rule]", 
    "originalLimitCheck"}], ",", 
   RowBox[{"\"\<Q = 0 gives zero conversion\>\"", "\[Rule]", 
    "zeroOverlapCheck"}]}], "]"}]}], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"0a376929-4366-a742-a052-306fc044e488"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Q = 1 recovers uploaded model\"\>", "\[Rule]", "True"}], ",", 
